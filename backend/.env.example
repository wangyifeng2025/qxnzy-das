APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qxnzy_das
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000"]
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 下面的 AI_* 优先于 DEEPSEEK_*。留空时继续使用上面的 DeepSeek 配置。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_PROVIDER=deepseek
AI_TIMEOUT_SECONDS=60
AI_MAX_CONCURRENCY=4
AI_MAX_CHUNK_CHARS=6000
AI_MAX_TOKENS=4096
# 推理模型（如 deepseek-flash）建议设为 true，否则思考 token 会挤占输出导致正文为空
AI_DISABLE_THINKING=false
AI_REDACT_FIELDS=[]
INGEST_MAX_PDF_PAGES=500
# 单份文件允许的非空单元格上限；45 列 × 2500 行的成绩表约 11 万，按需调整
INGEST_MAX_CELLS=500000
INGEST_FILE_RETENTION_DAYS=30
# 日志：默认同时输出到控制台和 storage/logs/<服务名>.log
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=./storage/logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
# 模型输出解析失败时记录原文片段；含业务敏感数据时可设为 false
LOG_FAILED_MODEL_OUTPUT=true

UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=20

# 认证：生产环境必须替换为至少 32 字节的随机密钥
JWT_SECRET_KEY=dev-only-secret-change-me-before-deploying-0123456789
ACCESS_TOKEN_EXPIRE_MINUTES=720

# 初始化数据（uv run python -m app.seeds.initial_data）
SCHOOL_CODE=4152014251
SCHOOL_NAME=黔西南民族职业技术学院
INITIAL_ADMIN_ACCOUNT=admin
INITIAL_ADMIN_NAME=系统管理员
INITIAL_ADMIN_PASSWORD=Admin@2026
